# Copy this file to .env.local and fill in your values.
# Never commit .env.local. These variables are read on the server only.

# YouTube Data API v3 key (Google Cloud Console > APIs & Services > Credentials)
YOUTUBE_API_KEY=

# Optional: override the channel. By default the handle in src/config/site.ts is used.
# YOUTUBE_CHANNEL_ID=
# YOUTUBE_CHANNEL_HANDLE=@VexorEditzOfficial

# Optional: your live domain, used for SEO metadata (Open Graph, sitemap).
# On Vercel, the production domain is detected automatically if this is empty.
NEXT_PUBLIC_SITE_URL=
